# Public app URL
NEXT_PUBLIC_APP_URL=https://silenthub-web.vercel.app

# Admin access. Replace immediately.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Optional external Discord webhook. NEVER expose as NEXT_PUBLIC_*.
DISCORD_WEBHOOK_URL=

# Optional geolocation provider. The app works without it.
# Example: https://ipapi.co/{ip}/json/
IP_GEOLOCATION_URL_TEMPLATE=

# Production storage/database adapters can be wired here later.
DATABASE_URL=
SCRIPT_STORAGE_PATH=./storage/scripts
